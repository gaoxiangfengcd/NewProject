# app-web 生产环境变量。复制为 .env.web：
#   cp .env.web.example .env.web
# 密钥生成：openssl rand -hex 24

# ---------- 运行模式 ----------
NODE_ENV=production
FREE_QUOTA_PER_MONTH=3
STORAGE_RETENTION_DAYS=7

# ---------- MySQL ----------
MYSQL_DATABASE=hairstyle
MYSQL_USER=app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=mysql://app:CHANGE_ME@web-mysql:3306/hairstyle

# ---------- Redis（BullMQ） ----------
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@web-redis:6379

# ---------- 站点 / 鉴权 ----------
APP_URL=https://hair.example.com
NEXT_PUBLIC_APP_URL=https://hair.example.com
NEXTAUTH_URL=https://hair.example.com
JWT_SECRET=
NEXTAUTH_SECRET=
ADMIN_EMAIL=

# ---------- Replicate ----------
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=google/nano-banana
REPLICATE_WEBHOOK_SECRET=
REPLICATE_WEBHOOK_BASE_URL=https://hair.example.com

# ---------- Cloudflare R2 ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---------- Paddle（未配则 mock） ----------
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_CREDIT1=
PADDLE_PRICE_CREDIT6=

# ---------- 可选：OAuth ----------
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ---------- 可选：监控 / 邮件 ----------
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production
POSTHOG_KEY=
POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=
