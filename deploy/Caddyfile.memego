# Caddy 反代配置（MeMeGo 单站点版）。
# 用途：本次只上线 memego 一个站点时使用，避免主 Caddyfile 中
# 其他未部署域名（OFFICIAL_DOMAIN / WEB_DOMAIN）为空导致 Caddy 解析失败。
#
# 用法：docker compose --env-file .env.proxy -f docker-compose.proxy.memego.yml up -d
# 环境变量：MEMEGO_DOMAIN=memego.jiandengcun.com · ACME_EMAIL=你的邮箱

{
	email {$ACME_EMAIL}
	servers {
		timeouts 120s
	}
}

# ---- Cloudflare 代理段（IPv4 + IPv6，来源 cloudflare.com/ips）----
# 让 Caddy 信任来自 CF 的 X-Forwarded-For
(cloudflare_proxies) {
	trusted_proxies \
		173.245.48.0/20 \
		103.21.244.0/22 \
		103.22.200.0/22 \
		103.31.4.0/22 \
		141.101.64.0/18 \
		108.162.192.0/18 \
		190.93.240.0/20 \
		188.114.96.0/20 \
		197.234.240.0/22 \
		198.41.128.0/17 \
		162.158.0.0/15 \
		104.16.0.0/13 \
		104.24.0.0/14 \
		172.64.0.0/13 \
		131.0.72.0/22 \
		2400:cb00::/32 \
		2606:4700::/32 \
		2803:f800::/32 \
		2405:b500::/32 \
		2405:8100::/32 \
		2a06:98c0::/29 \
		2c0f:f248::/32
}

{$MEMEGO_DOMAIN} {
	# Next.js 静态资产：immutable + 1 年，CF 边缘直接命中
	@static {
		path /_next/static/*
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# 分享图片对象不可变（每次生成都是新 key）：边缘缓存 7 天
	@shares {
		path /api/storage/shares/*
	}
	header @shares Cache-Control "public, max-age=604800, immutable"

	reverse_proxy memego:3001 {
		import cloudflare_proxies
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}
}
