{
  "name": "app-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx src/worker.ts",
    "db:generate": "prisma generate --schema=src/db/prisma/schema.prisma",
    "db:push": "prisma db push --schema=src/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=src/db/prisma/schema.prisma",
    "db:generate:mysql": "prisma generate --schema=src/db/prisma/schema.mysql.prisma",
    "db:push:mysql": "prisma db push --schema=src/db/prisma/schema.mysql.prisma",
    "cleanup:storage": "tsx scripts/cleanup-storage.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "@repo/auth": "workspace:*",
    "@repo/common": "workspace:*",
    "@repo/compliance": "workspace:*",
    "@repo/errors": "workspace:*",
    "@repo/notifications": "workspace:*",
    "@repo/payment": "workspace:*",
    "@repo/storage": "workspace:*",
    "@repo/tracking": "workspace:*",
    "bullmq": "^5.7.0",
    "ioredis": "^5.4.0",
    "mysql2": "^3.10.0",
    "nanoid": "^5.0.0",
    "next": "^14.2.0",
    "prisma": "^5.15.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "replicate": "^0.32.0",
    "sharp": "^0.33.5",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.5.4",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.5.26",
    "tailwindcss": "3.4.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0"
  }
}
