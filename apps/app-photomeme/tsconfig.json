{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "preserve",
    "allowJs": false,
    "noEmit": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@repo/common": [
        "../../packages/common/src/index.ts"
      ],
      "@repo/image-gen": [
        "../../packages/image-gen/src/index.ts"
      ],
      "@repo/storage": [
        "../../packages/storage/src/index.ts"
      ]
    },
    "incremental": true
  },
  "include": [
    "src",
    "scripts",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
