# 站点对外 URL（canonical / sitemap / 分享链接 / OG）
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# 火山引擎 Seedream 4.0（出图）。方舟图片生成只用一把 API Key。
# VOLC_ACCESS_KEY = 方舟控制台的 API Key（Bearer）
# VOLC_SECRET_KEY = 仅当走 visual.volcengineapi.com 的 IAM 签名时才需要
VOLC_ACCESS_KEY=xxx
# VOLC_SECRET_KEY=
VOLC_SEEDREAM_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
# 方舟控制台的推理接入点 ID
# 4.0（当前启用）
VOLC_SEEDREAM_MODEL=doubao-seedream-4-0-250828
# 5.0 Pro（更贵，需要时再打开）
# VOLC_SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628

# 读图分析（只看图、写出笑话方向，不出图）。mock | dashscope | zhipu | openai
# 大陆付款推荐 dashscope（通义 VL）。出图走上面的 Seedream，互不影响。
# ANALYSIS_PROVIDER=dashscope
# DASHSCOPE_API_KEY=
# DASHSCOPE_ANALYSIS_MODEL=qwen-vl-plus
# 服务器在海外连不通国内域名时改用国际站：
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
# ANALYSIS_PROVIDER=zhipu
# ZHIPU_API_KEY=
# ZHIPU_ANALYSIS_MODEL=glm-4v-flash
# ANALYSIS_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_ANALYSIS_MODEL=gpt-4o-mini

# 生成前的融合点推理（失败/超时 3s 则跳过，不阻塞出图）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
# DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
# deepseek_direct = skip Qwen, DeepSeek vision writes directions
# qwen_then_deepseek = Qwen analysis then DeepSeek text directions
ANALYSIS_MODE=deepseek_direct

# 逐步调试：设为 1 时生成接口停在 DeepSeek，不调用 Seedream
# DEBUG_STOP_AFTER_REASONING=1

# 每日免费预览次数（带水印，只做引流）
FREE_GENERATIONS_PER_DAY=1
# 礼物额度有效期（天）。0 = 剩余次数永不过期
CREDIT_TTL_DAYS=0
# 礼物包：id:生成次数:美分:price_id，多档用逗号分隔
# 1 份 = 5 次生成机会，每次都是高清无水印成品，用户挑最满意的那张
# PADDLE_PACKS=single:5:1999:pri_xxx,trio:15:4499:pri_yyy,quint:25:6999:pri_zzz
PADDLE_PACKS=
# 三个 price 所属的父商品（Catalog → Products）。结账按 price_id 走，代码不消费此值，仅作留档。
# PADDLE_PRODUCT_ID=pro_xxx
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
# Paddle.js 客户端 token（Dashboard → Checkout → Developer tools → Client-side token）。
# 前端用它在站内弹出收银台浮层；不配则退回整页跳转到 Hosted Checkout URL。
# 环境（sandbox/live）由 token 前缀自动判定（test_ 开头即 sandbox），无需额外变量。
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# 兼容单包写法（PADDLE_PACKS 为空时生效）
PAID_CREDITS_PER_PURCHASE=1
PAID_PRICE_CENTS=1999
PADDLE_PRICE_ID=
# 非生产默认允许「Add a test credit」；生产如需打开设为 1
# ALLOW_DEV_CREDIT_GRANT=1

# 生成接口 IP 限流（本地留空 REDIS_URL 则关闭限流）
REDIS_URL=
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_GENERATE_MAX=5

# 存储：二选一。本地开发用 LOCAL_STORAGE_DIR；生产推荐 R2
LOCAL_STORAGE_DIR=./storage-data
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://images.example.com

# 分享图片保留天数（cleanup:shares 按此清理）
STORAGE_RETENTION_DAYS=7
