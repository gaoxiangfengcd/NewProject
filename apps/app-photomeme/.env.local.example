# 图片生成 Provider：mock | replicate（留空时：有 REPLICATE_API_TOKEN 走 replicate，否则 mock）
IMAGE_GEN_PROVIDER=mock

# Replicate（https://replicate.com 申请 API Token；不配置则使用本地 mock 占位图）
REPLICATE_API_TOKEN=
# 可选：覆盖默认文生图模型
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell

# 生成接口 IP 限流（生产必填；本地留空则关闭限流）
REDIS_URL=
# 可选：限流参数（默认每 IP 每分钟 5 次）
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_GENERATE_MAX=5
