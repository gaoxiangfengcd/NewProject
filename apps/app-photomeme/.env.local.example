# 站点对外 URL（canonical / sitemap / 分享链接 / OG）
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# 图片生成 Provider：mock | replicate（留空时：有 REPLICATE_API_TOKEN 走 replicate，否则 mock）
# 无 token 的 mock 模式会直接回显上传图，可零成本走完全部流程
IMAGE_GEN_PROVIDER=

# Replicate（https://replicate.com 申请 API Token）
REPLICATE_API_TOKEN=
# 图生图模型。只配 REPLICATE_IMAGE_MODEL 时免费/付费共用该模型（后处理仍不同）。
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-1.1-pro
# 免费预览（建议便宜编辑模型）
# REPLICATE_IMAGE_MODEL_FREE=black-forest-labs/flux-kontext-dev
# 付费成图（建议更好的编辑模型）
# REPLICATE_IMAGE_MODEL_PAID=black-forest-labs/flux-kontext-pro
# REPLICATE_PROMPT_STRENGTH=

# 每日免费次数（按 IP；设备指纹以后再加）
FREE_GENERATIONS_PER_DAY=1
# 付费 HD：Paddle Billing（需 API key + 目录里的 Price ID）
PAID_CREDITS_PER_PURCHASE=1
PAID_PRICE_CENTS=299
PADDLE_API_KEY=
PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
# 非生产默认允许「Add a test credit」；生产如需打开设为 1
# ALLOW_DEV_CREDIT_GRANT=1

# 生成接口 IP 限流（本地留空 REDIS_URL 则关闭限流）
REDIS_URL=
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_GENERATE_MAX=5

# 存储：二选一。本地开发用 LOCAL_STORAGE_DIR；生产推荐 R2
LOCAL_STORAGE_DIR=./storage-data
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://images.example.com

# 分享图片保留天数（cleanup:shares 按此清理）
STORAGE_RETENTION_DAYS=7
