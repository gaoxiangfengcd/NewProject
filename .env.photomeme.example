# MeMeGo 生产环境变量。复制为 .env.photomeme：
#   cp .env.photomeme.example .env.photomeme
# Redis 密码生成：openssl rand -hex 24

# ---------- 运行模式 ----------
NODE_ENV=production

# ---------- 站点 ----------
NEXT_PUBLIC_SITE_URL=https://memego.jiandengcun.com

# ---------- Redis（限流用） ----------
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@memego-redis:6379

# ---------- 限流 ----------
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_GENERATE_MAX=5

# 进入来源和点击汇总。服务器上查看：
#   curl -s -H "Authorization: Bearer 这里的值" http://127.0.0.1:3100/api/insights
# 生成：openssl rand -hex 24
ANALYTICS_READ_KEY=

# ---------- 图片模型（图生图） ----------
IMAGE_GEN_PROVIDER=replicate
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL_FREE=black-forest-labs/flux-kontext-pro
REPLICATE_IMAGE_MODEL_PAID=black-forest-labs/flux-kontext-pro
# REPLICATE_PROMPT_STRENGTH=

# ---------- 免费预览 / 礼物包（Paddle） ----------
# 定位：纪念礼物。免费预览只做引流（带水印、更轻模型），真正「挑到满意」靠付费额度。
FREE_GENERATIONS_PER_DAY=1

# 礼物额度有效期（天）。0 = 剩余次数永不过期
CREDIT_TTL_DAYS=0

# 礼物包走 Creem。格式 id:生成次数:美分:product_id，多档用逗号分隔。
# 1 份礼物 = 5 次生成机会。三个一次性商品建在 Creem Products 里，金额与这里的美分一致。
# 密钥只写在服务器 .env.photomeme，不要提交。creem_test_ 开头会打到测试接口。
# Webhook：https://memego.jiandengcun.com/api/webhook/creem ，事件 checkout.completed
CREEM_PACKS=single:5:1999:prod_CHANGEME,trio:15:4499:prod_CHANGEME,quint:25:6999:prod_CHANGEME
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# 不配 CREEM_PACKS 时，用下面三个变量退化成一个包
PAID_CREDITS_PER_PURCHASE=1
PAID_PRICE_CENTS=1999
CREEM_PRODUCT_ID=
# ALLOW_DEV_CREDIT_GRANT=

# ---------- 存储（生产推荐 Cloudflare R2，与 CDN 同生态、免出口流量） ----------
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# 不用 R2 时改为容器内本地目录（compose 需挂载卷）：
# LOCAL_STORAGE_DIR=/data/storage

# ---------- 分享图片保留期 ----------
STORAGE_RETENTION_DAYS=7
