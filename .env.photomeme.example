# app-photomeme 生产环境变量。复制为 .env.photomeme：
#   cp .env.photomeme.example .env.photomeme
# 密钥生成：openssl rand -hex 24

# ---------- 运行模式 ----------
NODE_ENV=production

# ---------- Redis（限流用） ----------
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@photomeme-redis:6379

# ---------- 限流 ----------
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_GENERATE_MAX=5

# ---------- 图片模型 ----------
IMAGE_GEN_PROVIDER=replicate
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
