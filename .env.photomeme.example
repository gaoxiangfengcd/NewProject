# MeMeGo 生产环境变量。复制为 .env.photomeme：
#   cp .env.photomeme.example .env.photomeme
# Redis 密码生成：openssl rand -hex 24

# ---------- 运行模式 ----------
NODE_ENV=production

# ---------- 站点 ----------
NEXT_PUBLIC_SITE_URL=https://memego.jiandengcun.com

# ---------- Redis（限流用） ----------
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@memego-redis:6379

# ---------- 限流 ----------
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_GENERATE_MAX=5

# ---------- 图片模型（图生图） ----------
IMAGE_GEN_PROVIDER=replicate
REPLICATE_API_TOKEN=
REPLICATE_IMAGE_MODEL_FREE=black-forest-labs/flux-kontext-pro
REPLICATE_IMAGE_MODEL_PAID=black-forest-labs/flux-kontext-pro
# REPLICATE_PROMPT_STRENGTH=

# ---------- 免费预览 / 礼物包（Paddle） ----------
# 定位：纪念礼物。免费预览只做引流（带水印、更轻模型），真正「挑到满意」靠付费额度。
FREE_GENERATIONS_PER_DAY=1

# 礼物额度有效期（天）。0 = 剩余次数永不过期
CREDIT_TTL_DAYS=0

# 礼物包：id:生成次数:美分:price_id，多档用逗号分隔
# 1 份礼物 = 5 次生成机会，每次生成都是高清无水印成品，用户挑最满意的那张送人。
# 次数刻意限制：有限次数才能让用户认真选、快速收敛，而不是无限试下去。
# 三个 price 建在 Paddle 同一个商品下：Catalog → Products → 商品 → Prices → Add price
# 各档金额必须与这里写的美分一致（页面只按这里显示，实际扣款按 Paddle price）
PADDLE_PACKS=single:5:1999:pri_CHANGEME,trio:15:4499:pri_CHANGEME,quint:25:6999:pri_CHANGEME
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# 兼容旧的单包写法：不配 PADDLE_PACKS 时，用下面三个变量退化成一个包
PAID_CREDITS_PER_PURCHASE=1
PAID_PRICE_CENTS=1999
PADDLE_PRICE_ID=
# ALLOW_DEV_CREDIT_GRANT=

# ---------- 存储（生产推荐 Cloudflare R2，与 CDN 同生态、免出口流量） ----------
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
# 不用 R2 时改为容器内本地目录（compose 需挂载卷）：
# LOCAL_STORAGE_DIR=/data/storage

# ---------- 分享图片保留期 ----------
STORAGE_RETENTION_DAYS=7
